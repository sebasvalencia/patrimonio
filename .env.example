# Copy to .env and adjust. Docker Compose and backup.ps1 read this file.
# Do not commit .env.

POSTGRES_USER=acciones
POSTGRES_PASSWORD=change-me
POSTGRES_DB=acciones
POSTGRES_PORT=5432

# Host API (uvicorn/alembic outside Compose). Compose overrides this with host `db`.
DATABASE_URL=postgresql+psycopg://acciones:change-me@localhost:5432/acciones

API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000

PGADMIN_DEFAULT_EMAIL=acciones@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# If you change POSTGRES_USER or POSTGRES_DB, update pgadmin/servers.json to match.
